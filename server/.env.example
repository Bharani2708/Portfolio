# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Nodemailer Email Configuration (Optional - for real email dispatch)
# If using Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
